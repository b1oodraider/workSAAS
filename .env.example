# Скопируйте в .env. Сгенерировать ключ: python -c "import secrets; print(secrets.token_urlsafe(32))"
WS_SECRET_KEY=

# LLM: заполните ключ того провайдера, который выбран в config.toml (имя переменной = api_key_env)
ANTHROPIC_API_KEY=
